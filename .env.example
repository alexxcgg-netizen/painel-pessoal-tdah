ANTHROPIC_API_KEY=

# Login por PIN de 6 digitos - nao precisa preencher nada aqui, a primeira
# vez que voce abrir o painel ele pede pra voce escolher o PIN (fica
# guardado com hash no banco, nunca em texto puro). So esse ENV importa:
# liga o cookie de sessao "Secure" (so funciona atras de HTTPS de verdade -
# ver deploy/DEPLOY.md). Deixa em false pra testar local em http://localhost.
SECURE_COOKIES=false

# Opcional: define o PIN de 6 digitos no primeiro boot, se ainda nao houver um (nunca
# sobrescreve). Pra hospedagem sem terminal (ex: Render, ver deploy/RENDER.md) - sem isso,
# quem abrir a URL primeiro escolhe o PIN. Local/VPS: pode deixar vazio.
PAINEL_PIN_INICIAL=
# No Render (variavel RENDER definida pelo proprio Render) o PIN inicial e
# OBRIGATORIO: sem PIN configurado o app se recusa a subir, pra nunca ficar
# com /configurar-pin aberto numa URL publica.

# Opcional: "1" SO quando o painel roda atras de um proxy reverso (Caddy na VPS,
# Render) - faz o bloqueio de PIN errado usar o IP real do cliente (cabecalho
# X-Forwarded-For) em vez do IP do proxy. NAO ligue sem proxy na frente: ai
# qualquer um mandaria um X-Forwarded-For inventado e fugiria do bloqueio.
# PAINEL_ATRAS_DE_PROXY=1

# Integracao opcional com o painel da construtora (fase 2)
CONSTRUTORA_API_URL=
CONSTRUTORA_API_KEY=

# Sincronizacao bancaria automatica (Nubank, Caixa, Viacredi, Bradesco, etc.)
# Cadastro gratuito para uso pessoal em https://meu.pluggy.ai - veja o README
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID_NUBANK=

# Notificacao push (Web Push/VAPID). Gere com: python scripts/gerar_chaves_push.py
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Calendario da Apple/iCloud (so leitura). A senha tem que ser uma "senha
# especifica de app" gerada em appleid.apple.com - Seguranca > Senhas de
# app. A senha normal da Apple ID nao funciona aqui.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=

# Calculadora "que horas preciso sair", calculadora de gasto de viagem e
# sugestao de posto no meio do caminho (Google Routes + Geocoding + Places
# API, com transito real). Chave gratuita (cabe facil nos $200/mes de
# credito): https://console.cloud.google.com/ - pra sugestao de posto
# funcionar, habilite tambem "Geocoding API" e "Places API (New)" no mesmo
# projeto (a Routes API sozinha nao basta pra essa parte).
GOOGLE_MAPS_API_KEY=
# Endereco de origem padrao (sua casa) - opcional, senao pede toda vez
ENDERECO_CASA=

# Pedir Uber por voz (ex: "pede um Uber pra tal lugar daqui 20 minutos").
# Crie um app em https://developer.uber.com/dashboard (uso pessoal - a
# propria conta do Alex, sem precisar de aprovacao de producao da Uber).
# Depois de preencher CLIENT_ID e CLIENT_SECRET aqui, acesse /uber/conectar
# no painel (ja logado) pra autorizar com a conta Uber real - o painel NUNCA
# pede a corrida sozinho, so busca o preco e espera confirmacao explicita.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

# Cidade padrao pra previsao do tempo do dia a dia (aba Hoje) - risco de
# chuva e a que horas, via Open-Meteo (gratuito, sem chave). Nome de cidade
# simples, ex: "Brusque" ou "Blumenau, SC". Opcional - sem isso, o aviso de
# chuva do dia so aparece nos voos agendados (que ja tem destino proprio) e o
# aviso das 7h30 "vai chover no horario do compromisso" fica desligado.
CIDADE_PADRAO=

# Token opcional pra proteger /api/saude/importar (dados de Saude vindos de um
# Atalho do iPhone) - so necessario se voce hospedar o painel publicamente.
# Veja o README, secao "Saude".
SAUDE_WEBHOOK_TOKEN=

# Token dos Atalhos do iPhone que falam direto com o painel sem passar pelo
# login por PIN (captura por voz, PDF de cotacao, widget, localizacao
# casa/mercado e uso de apps). Localizacao e uso de apps NAO funcionam sem
# ele (devolvem agenda/lista de compras, entao nao ficam abertos). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Guia de montagem dos Atalhos: docs/ATALHOS.md
PAINEL_ATALHOS_TOKEN=

# Bot do Telegram - conversa com o painel direto pelo Telegram, como
# mandando mensagem pra uma pessoa (mesmo chat/captura do painel web, e as
# notificacoes proativas tambem chegam por aqui). Veja o README, secao
# "Bot do Telegram", pra pegar os dois valores com o @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Diretorio onde ficam os backups automaticos semanais do banco (domingo 3h da manha,
# mantem so os ultimos 8 - ~2 meses). Opcional - sem preencher, o padrao e' data/backups/
# dentro do projeto (ja coberto pelo .gitignore). Se TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID
# acima estiverem configurados, cada backup automatico tambem e' mandado pro Telegram.
# Veja docs/BACKUP.md pro guia completo de export/restauracao.
BACKUP_DIR=

# Criptografia em repouso do dado mais sensivel do banco: saldo/extrato do
# Open Finance (bank_accounts, bank_transactions) e dado de saude
# (saude_dados, medidas_corporais, medicamentos). Gere com:
#   python scripts/gerar_chave_criptografia.py
# Opcional - sem ela o app funciona normalmente, so que esses campos ficam
# em texto plano no banco (aviso no log e em /api/seguranca/status). NUNCA
# comite essa chave no git (o .env ja esta no .gitignore) - sem ela, tudo
# que foi cifrado com ela fica irrecuperavel pra sempre. Veja docs/SEGURANCA.md.
ENCRYPTION_KEY=

# Status de voo comercial em tempo real por numero (atraso, portao, terminal -
# US-F12, Fase 6 F3), depois de comprar a passagem (campo "numero do voo" na
# tela de Viagens). API escolhida: AviationStack (https://aviationstack.com) -
# cadastro gratuito so com email, sem cartao de credito, 100 requisicoes/mes
# gratis (o app cacheia por 3h a mesma consulta voo+data pra nao estourar).
# Pegue a chave em https://aviationstack.com/product -> "Get Free API Key".
# ATENCAO: o plano gratuito so aceita HTTP (nao HTTPS) - a chave viaja sem
# criptografia nessa consulta especifica (limitacao do provedor, nao do
# app - se um dia virar plano pago, HTTPS passa a funcionar). Ver
# tasks/fase6/progress-f3.txt e TODO.md pra comparacao com as outras APIs
# pesquisadas (AeroDataBox pede cartao mesmo no plano gratuito; FlightAware
# Personal tem so $5 gratis/mes; Amadeus Self-Service encerrou de vez em
# 2026-07-17). Sem essa chave, o card de voo funciona so com o numero
# digitado a mao e mostra "status em tempo real: configurar chave".
AVIATIONSTACK_API_KEY=

# ---------------------------------------------------------------------------
# Fase 7: IA hibrida, assistente proativo, widget, Telegram (todas opcionais)
# ---------------------------------------------------------------------------
# OpenAI (GPT-6 Luna/Sol). Cada funcao de IA so troca de modelo quando o
# `ativo` do ia/config.d/<funcao>.json for true (depois do teste A/B).
OPENAI_API_KEY=
# Gemini (desligado por padrao, candidato barato no A/B)
GEMINI_API_KEY=
# Transcricao de audio do Telegram (Groq whisper-large-v3-turbo, ver docs/telegram-captura.md)
GROQ_API_KEY=

# Textos longos e aleatorios que voce escolhe (ex: python -c "import secrets; print(secrets.token_urlsafe(32))")
# /api/tick - chamar a cada 5 min por um cron externo (docs/tick.md)
PAINEL_TICK_TOKEN=
# /api/sinal - automacoes do app Atalhos do iPhone (docs/atalhos-sinais.md)
PAINEL_SINAL_TOKEN=
# /api/widget e /widget - widgets do iPhone (docs/widget-*.md)
PAINEL_WIDGET_TOKEN=

# Captura pelo Telegram por webhook (docs/telegram-captura.md). So responde ao
# chat permitido. ATENCAO: webhook e polling nao podem usar o mesmo bot ao mesmo
# tempo - recomendado um bot separado do TELEGRAM_BOT_TOKEN acima.
TELEGRAM_CHAT_ID_PERMITIDO=
TELEGRAM_WEBHOOK_SECRET=
# Token de um bot SEPARADO so pra captura por webhook (recomendado; outro bot no
# @BotFather). Vazio = a captura usa o mesmo TELEGRAM_BOT_TOKEN do bot antigo.
TELEGRAM_BOT_TOKEN_CAPTURA=
# Quem roda: auto (padrao quando vazio), polling, webhook, ambos ou desligado. Com
# um bot so, webhook e polling nunca rodam juntos (o Telegram daria erro 409):
# "auto" escolhe o webhook quando TELEGRAM_WEBHOOK_SECRET esta preenchido, senao
# o polling. Pra voltar pro polling com um bot so: TELEGRAM_MODO=polling e
# deleteWebhook no Telegram. Detalhes em docs/telegram-captura.md, secao 7.
TELEGRAM_MODO=
# Endereco publico do app (links nas respostas do Telegram)
APP_URL_PUBLICA=

# API da construtora em modo simulado (dados sinteticos) - so pra teste/desenvolvimento
CONSTRUTORA_API_MOCK=
