ANTHROPIC_API_KEY=

# Login por PIN de 6 digitos - nao precisa preencher nada aqui, a primeira
# vez que voce abrir o painel ele pede pra voce escolher o PIN (fica
# guardado com hash no banco, nunca em texto puro). So esse ENV importa:
# liga o cookie de sessao "Secure" (so funciona atras de HTTPS de verdade -
# ver deploy/DEPLOY.md). Deixa em false pra testar local em http://localhost.
SECURE_COOKIES=false

# Integracao opcional com o painel da construtora (fase 2)
CONSTRUTORA_API_URL=
CONSTRUTORA_API_KEY=

# Sincronizacao bancaria automatica (Nubank, Caixa, Viacredi, Bradesco, etc.)
# Cadastro gratuito para uso pessoal em https://meu.pluggy.ai - veja o README
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Notificacao push (Web Push/VAPID). Gere com: python scripts/gerar_chaves_push.py
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Calendario da Apple/iCloud (so leitura). A senha tem que ser uma "senha
# especifica de app" gerada em appleid.apple.com - Seguranca > Senhas de
# app. A senha normal da Apple ID nao funciona aqui.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=

# Calculadora "que horas preciso sair", calculadora de gasto de viagem e
# sugestao de posto no meio do caminho (Google Routes + Geocoding + Places
# API, com transito real). Chave gratuita (cabe facil nos $200/mes de
# credito): https://console.cloud.google.com/ - pra sugestao de posto
# funcionar, habilite tambem "Geocoding API" e "Places API (New)" no mesmo
# projeto (a Routes API sozinha nao basta pra essa parte).
GOOGLE_MAPS_API_KEY=
# Endereco de origem padrao (sua casa) - opcional, senao pede toda vez
ENDERECO_CASA=

# Pedir Uber por voz (ex: "pede um Uber pra tal lugar daqui 20 minutos").
# Crie um app em https://developer.uber.com/dashboard (uso pessoal - a
# propria conta do Alex, sem precisar de aprovacao de producao da Uber).
# Depois de preencher CLIENT_ID e CLIENT_SECRET aqui, acesse /uber/conectar
# no painel (ja logado) pra autorizar com a conta Uber real - o painel NUNCA
# pede a corrida sozinho, so busca o preco e espera confirmacao explicita.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

# Cidade padrao pra previsao do tempo do dia a dia (aba Hoje) - risco de
# chuva e a que horas, via Open-Meteo (gratuito, sem chave). Nome de cidade
# simples, ex: "Brusque" ou "Blumenau, SC". Opcional - sem isso, o aviso de
# chuva do dia so aparece nos voos agendados (que ja tem destino proprio).
CIDADE_PADRAO=

# Token opcional pra proteger /api/saude/importar (dados de Saude vindos de um
# Atalho do iPhone) - so necessario se voce hospedar o painel publicamente.
# Veja o README, secao "Saude".
SAUDE_WEBHOOK_TOKEN=
