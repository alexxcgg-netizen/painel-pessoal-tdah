# Troca "seu-dominio.com" pelo dominio de verdade. O Caddy busca e renova o
# certificado HTTPS sozinho (Let's Encrypt) so por causa dessa linha - nao
# precisa mexer em certbot nem nada manual.
seu-dominio.com {
	# OPCIONAL: o painel ja tem login proprio por PIN de 6 digitos (auth.py) -
	# sozinho ja e suficiente pra proteger o painel num dominio publico. Esse
	# basicauth e so uma segunda camada de defesa (bloqueia antes mesmo de
	# chegar na tela de PIN) - ver deploy/DEPLOY.md, secao 0. Se nao quiser
	# essa camada a mais, remove o bloco basicauth inteiro.
	# Gera o hash com: caddy hash-password
	# (nunca cola a senha em texto puro aqui, so o hash que o comando devolve)
	basicauth {
		seu-usuario JDJhJDE0JGV4ZW1wbG8uZGUuaGFzaC5xdWUudm9jZS5jb2xhLmFxdWk
	}

	reverse_proxy 127.0.0.1:5001
}
